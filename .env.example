# Copy to .env.local to override the committed .env on your machine.

# The Convex deployment the app talks to. Public: it is bundled into the app.
EXPO_PUBLIC_CONVEX_URL=https://sensible-guineapig-9.convex.cloud

# Lets "npx convex dev --once" deploy without an interactive login.
# Never commit a real value.
CONVEX_DEPLOY_KEY=

# The backend's secrets are NOT read from this file. They live in the Convex
# deployment; set each with: npx convex env set NAME "$NAME"
#   OPENAI_API_KEY  SUPERMEMORY_API_KEY  WHOP_API_KEY  WHOP_ENVIRONMENT
#   WHOP_WEBHOOK_SECRET  KEIKI_API_KEY
