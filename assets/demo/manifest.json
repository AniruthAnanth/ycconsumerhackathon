{
  "note": "Demo media for the seeded league, the capture samples, the slides and the recording. Every image is generated: none is a photograph of a real person or place. People write the describing fields; scripts/demo-assets/build-manifest.mjs measures width, height, bytes and sha256. See scripts/demo-assets/README.md.",
  "fields": {
    "file": "Path under assets/demo.",
    "kind": "avatar (a player's picture), proof (a task proof), gesture (a quick-time drop proof showing the drop's gesture), group (a group-session photo with four people), wrong (a photo that proves nothing) or sample (bundled into the app as a stand-in for the camera).",
    "key": "The name code uses for the file: a SeedPhotoKey in convex/lib/seedPhotos.ts for a seeded file, a SampleMedia key in components/capture/samples for a sample.",
    "seeded": "True when convex/seed.ts puts the file in the demo league. The rest are spare proofs for a live demo.",
    "player": "The seeded player the file belongs to.",
    "slot": "The lineup slot of the task the photo proves.",
    "taskTitle": "The task the photo is a proof for.",
    "pass": "Whether the referee should accept the photo for that task.",
    "reason": "The one-line reason the referee gives in its verdict.",
    "caption": "The caption shown with the proof in the feed."
  },
